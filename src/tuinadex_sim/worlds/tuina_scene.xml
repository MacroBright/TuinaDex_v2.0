<?xml version="1.0" ?>
<mujoco model="tuina_scene">
  <compiler angle="radian" meshdir="../meshes" autolimits="true"/>
  <!-- ============================================================================== -->
  <!-- 1. 仿真全局动力学与时间步配置 (Global Physics & Dynamics Options)                -->
  <!-- ============================================================================== -->
  <!-- 
    - timestep: 物理积分步长 (秒)。默认 0.002s 即 500 Hz，保障刚体接触稳定 (ROS2 50Hz 降采样发布)
    - gravity: 重力加速度 (x y z)，默认 -9.81 m/s^2 沿 -Z 方向
    - integrator: 积分器算法。'implicitfast' 为针对弹簧阻尼接触优化的隐式快速积分器
  -->
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <!-- ============================================================================== -->
  <!-- 2. 全局执行器 KD 参数统一配置 (在此修改 kp/kv 即可覆盖全部 16 个电机)           -->
  <!-- ============================================================================== -->
  <!--
    【统一调参入口】:
    - kp: 比例刚度系数 (Stiffness, N·m/rad, 默认 35.0)。调大手指更硬更有力，调小更柔顺。
    - kv: 微分阻尼系数 (Damping / Kd, N·m·s/rad, 默认 1.5)。调大抑制抖动超调，调小响应更快。
    在此处修改后，下方 16 个关节执行器自动统一继承生效！
    (注: 若后续某个特定关节需差异化定制，仍可在下方 <actuator> 对应行单独写 kp=".." kv=".." 覆盖)
  -->
  <default>
    <position kp="35.0" kv="1.5"/>
  </default>
  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
    <rgba haze="0.15 0.25 0.35 1.0"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.15 0.2" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
    <material name="bed_frame" rgba="0.25 0.25 0.28 1.0" specular="0.3"/>
    <material name="bed_mattress" rgba="0.18 0.42 0.70 1.0" specular="0.2"/>
    <material name="dummy_skin" rgba="0.88 0.75 0.63 1.0" specular="0.1"/>
    <mesh name="palm_lower" file="palm_lower.stl"/>
    <mesh name="mcp_joint" file="mcp_joint.stl"/>
    <mesh name="pip" file="pip.stl"/>
    <mesh name="dip" file="dip.stl"/>
    <mesh name="fingertip" file="fingertip.stl"/>
    <mesh name="thumb_pip" file="thumb_pip.stl"/>
    <mesh name="thumb_dip" file="thumb_dip.stl"/>
    <mesh name="thumb_fingertip" file="thumb_fingertip.stl"/>
  </asset>
  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <light pos="1.5 1.5 2.0" dir="-0.5 -0.5 -0.8" diffuse="0.5 0.5 0.5"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <body name="tuina_bed" pos="0 0 0">
      <geom name="bed_frame" type="box" size="0.95 0.375 0.30" pos="0 0 0.30" material="bed_frame"/>
      <geom name="bed_mattress" type="box" size="0.95 0.375 0.04" pos="0 0 0.64" material="bed_mattress"/>
      <body name="patient_dummy" pos="0 0 0">
        <geom name="dummy_torso" type="box" size="0.30 0.18 0.09" pos="0.20 0 0.77" material="dummy_skin"/>
        <geom name="dummy_head" type="sphere" size="0.11" pos="0.65 0 0.79" material="dummy_skin"/>
        <geom name="dummy_legs" type="box" size="0.35 0.16 0.07" pos="-0.45 0 0.75" material="dummy_skin"/>
      </body>
    </body>

    <!-- ========================================================================== -->
    <!-- 2. 灵巧手在仿真世界中的空间位置与姿态 (Spatial Position & Orientation)      -->
    <!-- ========================================================================== -->
    <!-- 
      - pos="x y z" (米):
          x: 沿推拿床长轴 (+x 头部方向, -x 腿部方向；假人背部中心在 x=0.20)
          y: 沿推拿床短轴 (0 为床体正中脊椎线, +y 左侧, -y 右侧)
          z: 离地垂直高度 (床面高 0.64m, 假人背部高 0.86m;
             z=0.95 表示手掌悬浮在背部上方 9cm, 手指全开平伸时指尖离背部约 7cm)
             * 调低 (如 z=0.91): 手掌更贴近假人背部，更易产生接触按压
             * 调高 (如 z=0.98): 手掌距离背部更远，避免未弯曲时误触
      - euler="roll pitch yaw" (弧度):
          roll=0: 掌心垂直朝下 (-Z 方向，正对患者背部)
          pitch=0: 掌心前后水平，无前倾或后仰
          yaw=1.57079 (pi/2): 掌心顺时针偏转 90°，手指横跨脊柱方向推拿
    -->
    <body name="leap_hand" pos="0.20 0 0.95" euler="0 0 1.57079">
      <geom pos="-0.0200952 0.0257578 -0.0347224" quat="1 0 0 0" type="mesh" rgba="0.603922 0.14902 0.14902 1" mesh="palm_lower"/>
