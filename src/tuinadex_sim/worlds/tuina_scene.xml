  <!-- ============================================================================== -->
  <!-- 4. 执行器定义 (16 个关节已自动继承上方 default 的统一 kp 和 kv 参数)            -->
  <!-- ============================================================================== -->
  <!--
    全部 16 个关节统一采用上方 <default> 中的 kp 与 kv。
    如需单独针对某个手指修改，可在此处单独追加 kp=".." kv=".." 覆盖全局默认值。
  -->
  <actuator>
    <!-- 食指 (Index Finger) 4 关节 -->
    <position name="act_index_yaw" joint="index_yaw" ctrlrange="-0.35 0.35"/>
    <position name="act_index_mcp" joint="index_mcp" ctrlrange="0.00 2.00"/>
    <position name="act_index_pip" joint="index_pip" ctrlrange="0.00 1.85"/>
    <position name="act_index_dip" joint="index_dip" ctrlrange="0.00 1.80"/>

    <!-- 中指 (Middle Finger) 4 关节 -->
    <position name="act_middle_yaw" joint="middle_yaw" ctrlrange="-0.35 0.35"/>
    <position name="act_middle_mcp" joint="middle_mcp" ctrlrange="0.00 2.00"/>
    <position name="act_middle_pip" joint="middle_pip" ctrlrange="0.00 1.85"/>
    <position name="act_middle_dip" joint="middle_dip" ctrlrange="0.00 1.80"/>

    <!-- 无名指 (Ring Finger) 4 关节 -->
    <position name="act_ring_yaw" joint="ring_yaw" ctrlrange="-0.35 0.35"/>
    <position name="act_ring_mcp" joint="ring_mcp" ctrlrange="0.00 2.00"/>
    <position name="act_ring_pip" joint="ring_pip" ctrlrange="0.00 1.85"/>
    <position name="act_ring_dip" joint="ring_dip" ctrlrange="0.00 1.80"/>

    <!-- 拇指 (Thumb) 4 关节 -->
    <position name="act_thumb_yaw" joint="thumb_yaw" ctrlrange="-0.30 1.80"/>
    <position name="act_thumb_cmc" joint="thumb_cmc" ctrlrange="0.00 1.60"/>
    <position name="act_thumb_mcp" joint="thumb_mcp" ctrlrange="0.00 1.80"/>
    <position name="act_thumb_ip" joint="thumb_ip" ctrlrange="0.00 1.80"/>
  </actuator>

  <!-- ============================================================================== -->
  <!-- 4. 接触碰撞过滤与刚体交互 (Contact Pairs & Self-Collision Filtering)          -->
  <!-- ============================================================================== -->
  <!--
    过滤手掌基座与手指首关节之间的相邻网格自碰撞穿透，避免虚假接触内力导致系统爆炸。
  -->
  <contact>
    <exclude body1="leap_hand" body2="mcp_joint"/>
    <exclude body1="leap_hand" body2="mcp_joint_2"/>
    <exclude body1="leap_hand" body2="mcp_joint_3"/>
    <exclude body1="leap_hand" body2="pip_4"/>
    <exclude body1="leap_hand" body2="thumb_pip"/>
    <exclude body1="leap_hand" body2="thumb_dip"/>
  </contact>
</mujoco>
