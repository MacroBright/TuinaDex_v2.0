<mujoco model="tuina_sim_scene">
  <compiler angle="radian" meshdir="../meshes" autolimits="true"/>

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <!-- Global dynamic defaults -->
    <joint limited="true" damping="0.5" armature="0.01"/>
    <position kp="35.0" kv="1.5"/>
    <geom friction="1.2 0.01 0.001" solref="0.004 1" solimp="0.95 0.99 0.001"/>

    <!-- LEAP Hand specific joint dynamic defaults (low inertia fingers) -->
    <default class="leap_hand">
      <joint damping="0.03" armature="0.001"/>
    </default>
  </default>

  <visual>
    <headlight ambient="0.2 0.2 0.2" diffuse="0.3 0.3 0.3" specular="0.05 0.05 0.05"/>
    <rgba haze="0.15 0.25 0.35 1.0"/>
    <global azimuth="135" elevation="-25"/>
  </visual>

  <asset>
