    <material name="dummy_skin_mat" rgba="0.88 0.75 0.63 1.0" specular="0.1"/>

    <!-- Patient Torso Mesh (Decimated <200k faces for MuJoCo STL limits, adult 1.5x scale) -->
    <mesh name="male_torso" file="visual/male_torso.stl" scale="0.0036 0.0036 0.0036"/>

    <!-- Shared Robot Finish Palette -->
    <material name="rs_base_black" rgba="0.055 0.065 0.060 1"/>
