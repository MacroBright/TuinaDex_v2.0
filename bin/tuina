#!/usr/bin/env bash
# ==============================================================================
# TuinaDex v2.0 - Unified System CLI Entrypoint (tuina)
#
# Resolves workspace root and loads ROS 2 / workspace baselines cleanly without
# leaking cross-version Conda Python 3.10 PYTHONPATH/cmeel libraries into native
# ROS 2 Lyrical (Python 3.14) child processes. Subprocess runtime isolation
# (control / vla / ros2 / bash) is enforced by tuinadex_bringup.cli.env_detector.
# ==============================================================================

set -eo pipefail

# 1. Resolve repository root (follow symlinks so ~/.local/bin/tuina works)
SOURCE="${BASH_SOURCE[0]}"
while [ -L "${SOURCE}" ]; do
    DIR="$(cd -P "$(dirname "${SOURCE}")" >/dev/null 2>&1 && pwd)"
    TARGET="$(readlink "${SOURCE}")"
    if [[ "${TARGET}" == /* ]]; then
        SOURCE="${TARGET}"
    else
        SOURCE="${DIR}/${TARGET}"
    fi
done
SCRIPT_DIR="$(cd -P "$(dirname "${SOURCE}")" >/dev/null 2>&1 && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." >/dev/null 2>&1 && pwd)"
export TUINADEX_ROOT="${REPO_ROOT}"

# 2. Source ROS 2 base & built workspace if present (safely without nounset errors)
ROS_DISTRO="${ROS_DISTRO:-lyrical}"
export ROS_DISTRO

if [ -f "/opt/ros/${ROS_DISTRO}/setup.bash" ]; then
    # shellcheck disable=SC1090
    source "/opt/ros/${ROS_DISTRO}/setup.bash"
fi

if [ -f "${REPO_ROOT}/install/setup.bash" ]; then
    # shellcheck disable=SC1091
    source "${REPO_ROOT}/install/setup.bash"
fi

# 3. Configure CycloneDDS silently only if rmw_cyclonedds_cpp is installed
_cyclonedds_found=0
for _lib_candidate in \
    "/opt/ros/${ROS_DISTRO}/lib/librmw_cyclonedds_cpp.so" \
    "/opt/ros/${ROS_DISTRO}/lib/x86_64-linux-gnu/librmw_cyclonedds_cpp.so" \
    "/opt/ros/${ROS_DISTRO}/lib/aarch64-linux-gnu/librmw_cyclonedds_cpp.so" \
    "/usr/lib/librmw_cyclonedds_cpp.so" \
    "/usr/lib/x86_64-linux-gnu/librmw_cyclonedds_cpp.so" \
    "/usr/lib/aarch64-linux-gnu/librmw_cyclonedds_cpp.so"; do
    if [ -f "${_lib_candidate}" ]; then
        _cyclonedds_found=1
        break
    fi
done

if [ "${_cyclonedds_found}" -eq 1 ]; then
    export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-42}"
    export RMW_IMPLEMENTATION="rmw_cyclonedds_cpp"
    if [ -f "${REPO_ROOT}/scripts/env/cyclonedds.xml" ]; then
        export CYCLONEDDS_URI="file://${REPO_ROOT}/scripts/env/cyclonedds.xml"
    fi
fi

# 4. Select clean launcher Python (tuinadex_bringup.cli is 100% pure stdlib)
# Prefer system /usr/bin/python3 so native Python 3.14 matches ROS 2 cleanly,
# falling back cleanly if absent.
TARGET_PYTHON=""
if [ -x "/usr/bin/python3" ]; then
    TARGET_PYTHON="/usr/bin/python3"
elif command -v python3 >/dev/null 2>&1; then
    TARGET_PYTHON="$(command -v python3)"
elif [ -x "${HOME}/win_office/conda/envs/tuinadex-control/bin/python" ]; then
    TARGET_PYTHON="${HOME}/win_office/conda/envs/tuinadex-control/bin/python"
else
    echo "[tuina ERROR] No usable python3 interpreter found." >&2
    exit 1
fi

# Inject only tuinadex_bringup source path ahead of PYTHONPATH so local CLI
# changes take effect immediately without contaminating C-extension site-packages.
SRC_BRINGUP="${REPO_ROOT}/src/tuinadex_bringup"
if [ -n "${PYTHONPATH:-}" ]; then
    export PYTHONPATH="${SRC_BRINGUP}:${PYTHONPATH}"
else
    export PYTHONPATH="${SRC_BRINGUP}"
fi

exec "${TARGET_PYTHON}" -m tuinadex_bringup.cli.main "$@"
