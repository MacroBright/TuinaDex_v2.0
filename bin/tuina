#!/usr/bin/env bash
# ==============================================================================
# TuinaDex v2.0 Unified CLI Launcher (tuina)
# Provides auto-detection for conda environments, ROS 2 and DDS baselines.
# ==============================================================================
set -e

# Resolve repository root from real path of this launcher
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
REPO_ROOT="$(cd "$BIN_DIR/.." >/dev/null 2>&1 && pwd)"

export TUINADEX_ROOT="${REPO_ROOT}"

# 1. Source ROS 2 Lyrical baseline if available
if [ -f "/opt/ros/lyrical/setup.bash" ]; then
    # shellcheck disable=SC1091
    source "/opt/ros/lyrical/setup.bash"
fi
if [ -f "${REPO_ROOT}/install/setup.bash" ]; then
    # shellcheck disable=SC1091
    source "${REPO_ROOT}/install/setup.bash"
fi

# 2. Source CycloneDDS baseline if available
if [ -f "${REPO_ROOT}/scripts/env/setup_cyclonedds.sh" ]; then
    # shellcheck disable=SC1091
    source "${REPO_ROOT}/scripts/env/setup_cyclonedds.sh" >/dev/null 2>&1 || true
fi

# 3. Locate Python executable (Prefer tuinadex-control conda env)
PY_CANDIDATES=(
    "${TUINADEX_CONTROL_PYTHON:-}"
    "$HOME/win_office/conda/envs/tuinadex-control/bin/python"
    "$HOME/miniconda3/envs/tuinadex-control/bin/python"
    "$(which python3 2>/dev/null || true)"
)

TARGET_PYTHON=""
for candidate in "${PY_CANDIDATES[@]}"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
        TARGET_PYTHON="$candidate"
        break
    fi
done

if [ -z "$TARGET_PYTHON" ]; then
    echo "❌ [tuina] Failed to locate a valid Python interpreter." >&2
    exit 1
fi

# 4. Fix Boost / Pinocchio dynamic library priority for Python 3.10
CONDA_DIR="$(dirname "$(dirname "$TARGET_PYTHON")")"
CMEEL_LIB="${CONDA_DIR}/lib/python3.10/site-packages/cmeel.prefix/lib"
if [ -d "$CMEEL_LIB" ]; then
    export LD_LIBRARY_PATH="${CMEEL_LIB}:${CONDA_DIR}/lib:${LD_LIBRARY_PATH:-}"
fi

# 5. Inject PYTHONPATH for source packages
SRC_DIR="${REPO_ROOT}/src"
export PYTHONPATH="${SRC_DIR}/tuinadex_bringup:${SRC_DIR}/tuinadex_core:${SRC_DIR}/tuinadex_teleop:${SRC_DIR}/tuinadex_sim:${SRC_DIR}/tuinadex_hand:${SRC_DIR}/tuinadex_arm:${SRC_DIR}/rebot_control:${REPO_ROOT}/dataset:${PYTHONPATH:-}"

# 6. Execute Python CLI entrypoint
exec "$TARGET_PYTHON" -m tuinadex_bringup.cli.main "$@"
